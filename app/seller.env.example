STOREMIND_SELLER_NAME=
STOREMIND_SELLER_URL=
STOREMIND_SELLER_PRIVACY_POLICY=
STOREMIND_SELLER_TOS=

# --- Merchant identity verification (either-or — see seller_profile.py) ---
# Any ONE path is enough: GSTIN alone, Udyam alone, UPI+PAN together, or
# UPI+WhatsApp together. Leave the others blank once one path is set.
STOREMIND_SELLER_GSTIN=
STOREMIND_SELLER_UDYAM=
STOREMIND_SELLER_PAN=
STOREMIND_SELLER_UPI_ID=
STOREMIND_SELLER_WHATSAPP_PHONE=

# --- ONDC: packer identity ---
# is_packer=true only if the seller packs their own goods (handmade,
# home-packed) — leave false and set PACKER_NAME/ADDRESS separately for a
# reseller of branded goods. Never assumed either way.
STOREMIND_SELLER_IS_PACKER=
STOREMIND_SELLER_PACKER_NAME=
STOREMIND_SELLER_PACKER_ADDRESS=

# --- ONDC: consumer care contact (all three required together) ---
STOREMIND_SELLER_CONSUMER_CARE_NAME=
STOREMIND_SELLER_CONSUMER_CARE_EMAIL=
STOREMIND_SELLER_CONSUMER_CARE_PHONE=

# --- ONDC: fulfillment policy ---
STOREMIND_SELLER_RETURNABLE=
STOREMIND_SELLER_RETURN_WINDOW_DAYS=
STOREMIND_SELLER_CANCELLABLE=
STOREMIND_SELLER_TIME_TO_SHIP_HOURS=
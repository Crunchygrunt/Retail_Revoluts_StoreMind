# Copy to .env (or export manually) and adjust as you move through phases.

# ---- LLM backend: mock | aistudio | vertexai --------------------------
# mock      offline, no deps beyond requirements.txt, deterministic-ish,
#           exercises all 3 fallback-parser layers on purpose. Default.
# aistudio  real Gemini via a free Google AI Studio API key — no GCP
#           project needed. pip install -r requirements-aistudio.txt
# vertexai  real Gemini via Vertex AI — needs a GCP project.
#           pip install -r requirements-gcp.txt
STOREMIND_LLM_BACKEND=mock

# Only used when STOREMIND_LLM_BACKEND=aistudio.
# Get a free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.6-flash if unset. Quotas are tracked
# PER MODEL — if you exhaust gemini-3.6-flash's daily quota, trying a
# different model (e.g. gemini-2.5-flash, gemini-3.1-flash-lite) uses a
# separate, likely-untouched quota bucket. No code changes needed, just
# set this and restart the server.
STOREMIND_AISTUDIO_MODEL=gemini-3.6-flash

# Only used when STOREMIND_LLM_BACKEND=vertexai.
GOOGLE_CLOUD_PROJECT=
# NOTE: gemini-3.6-flash (and 3.7, 3.8) are published to Vertex AI's
# "global" location ONLY, not regional locations like us-central1 — using
# a regional location here returns a 404 "Publisher model ... was not
# found" error. This does not need to match your Cloud Run deploy region
# or your Firestore location; it's independent.
GOOGLE_CLOUD_LOCATION=global
# Optional. Defaults to gemini-3.6-flash if unset.
STOREMIND_VERTEXAI_MODEL=gemini-3.6-flash

# ---- Store backend: local | firestore ----------------------------------
# local      writes to app/local_store_data.json — no GCP needed. Default.
# firestore  writes to real Firestore — needs a GCP project + auth.
STOREMIND_STORE_BACKEND=local
